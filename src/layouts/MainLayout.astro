---
// src/layouts/MainLayout.astro
import Header from "../components/Header.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-br" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta
            name="description"
            content="Calvele Burguer - O melhor artesanal da Ilha do Governador"
        />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title} | Calvele Burguer</title>
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="bg-calvele-dark text-white font-sans">
        <Header />

        <main class="pt-16 md:pt-20">
            <slot />
        </main>

        <footer class="bg-black py-12 px-4 border-t border-white/5">
            <div class="max-w-6xl mx-auto text-center">
                <span class="text-xl font-black italic tracking-tighter uppercase">
                    CALVELE <span class="text-calvele-red">.</span>
                </span>
                <p class="text-gray-500 text-sm mt-4">
                    Ilha do Governador - R. Ituá, 1678 - Jardim Guanabara, Rio
                    de Janeiro - RJ, 21940-184
                </p>
                <div class="flex justify-center gap-6 mt-6">
                    <a
                        href="https://www.instagram.com/calveleburguer/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-gray-400 hover:text-white transition font-medium"
                    >
                        Instagram
                    </a>
                </div>
            </div>
        </footer>
    </body>
</html>

<style is:global>
    :root {
        --font-sans: 'Inter', sans-serif;
    }
    html {
        scroll-behavior: smooth;
    }
    body {
        font-family: var(--font-sans);
    }
</style>
