---
// 1. Importações
import MainLayout from '../layouts/MainLayout.astro';
import BurgerCard from '../components/BurgerCard.astro';

// 2. Importando as imagens (Assets)
import imgBurger1 from '../assets/costelaco.webp';

// 3. A "Base de Dados" do Cardápio
const FAVORITOS = [
  {
    titulo: "Costelaço Trufado",
    descricao: "Pão australiano, 150g de carne suculenta, queijo prato, cobertos com costela bovina desfiada, maionese trufada e cebola roxa. ( Bruto, Macio e Inesquecível)",
    preco: "R$ 49,90",
    imagem: imgBurger1, // Usando a variável da imagem importada
	linkIfood: "https://www.ifood.com.br/delivery/rio-de-janeiro-rj/calvele-burguer-jardim-guanabara/f34f5af4-e095-42dc-849c-0b5ff080b44f?utm_source=orderfood&prato=5baa4eb5-4947-49b1-99e0-32de3f924894",
    link99: "https://food.99app.com/seu-link-aqui"
  },
];
---

<MainLayout title="Início">
  
  <section class="relative min-h-[85vh] flex items-center justify-center bg-calvele-dark text-center px-4 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-t from-calvele-dark via-transparent to-transparent z-10"></div>
    
    <div class="relative z-20 max-w-4xl flex flex-col items-center">
      <h1 class="text-5xl md:text-7xl font-black text-white mb-6 italic tracking-tighter leading-none">
        MATA A SUA <span class="text-calvele-red">FOME.</span>
      </h1>
      <p class="text-gray-300 text-lg md:text-xl mb-10 max-w-xl">
        O verdadeiro hambúrguer artesanal da região. Escolha seu app favorito e receba quentinho em casa.
      </p>
      
      <div class="flex flex-col md:flex-row gap-4 w-full md:w-auto">
        
        <a href="https://www.ifood.com.br/delivery/rio-de-janeiro-rj/calvele-burguer-jardim-guanabara/f34f5af4-e095-42dc-849c-0b5ff080b44f?utm_source=orderfood" class="group relative bg-[#EA1D2C] text-white font-bold py-4 px-10 rounded-full hover:bg-red-700 transition shadow-lg shadow-red-900/30 flex items-center justify-center gap-3">
          <span class="bg-white text-[#EA1D2C] rounded-full w-6 h-6 flex items-center justify-center text-xs font-black">i</span>
          PEDIR NO IFOOD
        </a>

		<a href="LINK_99_GERAL" class="group relative bg-[#FF5500] text-white font-bold py-4 px-10 rounded-full hover:bg-orange-600 transition shadow-lg shadow-orange-900/30 flex items-center justify-center gap-3">
		<span class="bg-white text-[#FF5500] rounded-full w-6 h-6 flex items-center justify-center text-xs font-black">9</span>
		<span class="block md:hidden">PEDIR NO 99FOOD</span>
		<span class="hidden md:block">BAIXAR APP 99FOOD</span>
		</a>

      </div>
      
      <p class="mt-6 text-sm text-gray-500 font-medium">
        Entregamos em um raio de 8km (descobrir)🛵
      </p>
    </div>
  </section>

  <section id="favoritos" class="bg-calvele-dark py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">OS MAIS PEDIDOS</h2>
        <div class="h-1 w-20 bg-calvele-yellow mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {FAVORITOS.map((burger) => (
          <BurgerCard 
            title={burger.titulo}
            desc={burger.descricao}
            price={burger.preco}
            image={burger.imagem}
            linkIfood={burger.linkIfood}
            link99={burger.link99}
          />
        ))}
      </div>
    </div>
  </section>
</MainLayout>