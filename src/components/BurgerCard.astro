---
import { Image } from "astro:assets";

interface Props {
    title: string;
    desc: string;
    price: string;
    image: ImageMetadata;
    linkIfood?: string; // Opcional (pode ser que um item não esteja em um app)
    link99?: string; // Opcional
}

// Valores padrão com "#" caso você esqueça de passar o link
const {
    title,
    desc,
    price,
    image,
    linkIfood = "#",
    link99 = "#",
} = Astro.props;
---

<article
    class="bg-stone-900 rounded-2xl overflow-hidden border border-white/10 hover:border-calvele-yellow transition-all group flex flex-col h-full shadow-lg"
>
    <div class="h-56 overflow-hidden relative">
        <Image
            src={image}
            alt={title}
            width={600}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div
            class="absolute bottom-0 right-0 bg-calvele-yellow text-calvele-dark font-black px-4 py-1 rounded-tl-lg"
        >
            {price}
        </div>
    </div>

    <div class="p-5 flex flex-col flex-grow">
        <h3 class="text-xl font-bold text-white mb-2 leading-tight">{title}</h3>
        <p class="text-gray-400 text-sm mb-6 flex-grow leading-relaxed">
            {desc}
        </p>

        <div class="flex gap-2 mt-auto">
            <a
                href={linkIfood}
                target="_blank"
                class="flex-1 bg-[#EA1D2C] hover:bg-red-700 text-white text-xs md:text-sm font-bold py-3 px-2 rounded-lg text-center transition flex items-center justify-center gap-1"
            >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                    ><path
                        d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                    ></path></svg
                >
                iFood
            </a>

            <a
                href={link99}
                target="_blank"
                class="md:hidden flex-1 bg-[#FF5500] hover:bg-orange-700 text-white text-xs md:text-sm font-bold py-3 px-2 rounded-lg text-center transition flex items-center justify-center gap-1"
            >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                    ><path
                        d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                    ></path></svg
                >
                99Food
            </a>
        </div>
    </div>
</article>
