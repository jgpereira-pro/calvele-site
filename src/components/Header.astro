---
// src/components/Header.astro
import { CATEGORIAS } from "../data/menu";
---

<header class="fixed top-0 left-0 w-full bg-calvele-dark/90 backdrop-blur-md border-b border-white/10 z-50">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex items-center justify-between h-16 md:h-20">
      
      <div class="flex items-center gap-4 md:gap-6">
        <button 
          id="menu-toggle"
          class="text-white hover:text-calvele-yellow transition-colors focus:outline-none p-1"
          aria-label="Abrir menu de navegação"
          aria-expanded="false"
          aria-controls="sidebar-menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
          </svg>
        </button>

        <a href="/" class="flex items-center gap-2 group">
          <span class="text-2xl font-black italic text-white tracking-tighter uppercase group-hover:scale-105 transition-transform">
            CALVELE <span class="text-calvele-red text-3xl">.</span>
          </span>
        </a>
      </div>

      <div class="flex items-center gap-4">
        <a 
          href="#novidades" 
          class="hidden md:block text-sm font-bold text-gray-300 hover:text-white uppercase tracking-wider transition-colors"
        >
          Cardápio Completo
        </a>

        <a
          href="https://www.ifood.com.br/delivery/rio-de-janeiro-rj/calvele-burguer-jardim-guanabara/f34f5af4-e095-42dc-849c-0b5ff080b44f"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-calvele-red text-white text-xs md:text-sm font-black py-2.5 px-5 md:px-8 rounded-full hover:bg-red-700 hover:shadow-lg hover:shadow-red-900/40 transition-all flex items-center gap-2"
        >
          PEDIR AGORA
        </a>
      </div>
    </div>
  </div>
</header>

<div 
  id="menu-overlay"
  class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[60] opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<aside 
  id="sidebar-menu"
  class="fixed top-0 left-0 h-full w-[85vw] max-w-md bg-[#1a1a1a] z-[70] transform -translate-x-full transition-transform duration-300 shadow-2xl border-r border-white/10 flex flex-col"
  aria-hidden="true"
>
  <div class="flex items-center justify-between p-6 border-b border-white/10">
    <span class="text-xl font-black italic text-white tracking-tighter uppercase">
      NAVEGAÇÃO
    </span>
    <button 
      id="menu-close"
      class="text-gray-400 hover:text-white p-2 rounded-full hover:bg-white/10 transition-colors"
      aria-label="Fechar menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="flex-1 overflow-y-auto py-6 px-6"> 
    <div class="mb-8">
      <h3 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4">Sobre a Calvele</h3>
      <nav class="flex flex-col gap-1">
        <a href="/" class="text-white text-lg font-bold py-2 hover:text-calvele-yellow transition-colors flex items-center gap-3 sidebar-link">
          Início
        </a>
        <a href="#historia" class="text-white text-lg font-bold py-2 hover:text-calvele-yellow transition-colors flex items-center gap-3 sidebar-link">
          Nossa História
        </a>
      </nav>
    </div>

    <div class="mb-8">
      <h3 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4">Cardápio</h3>
      <nav class="flex flex-col gap-1 pl-2 border-l-2 border-white/10">
        {CATEGORIAS.map((cat) => (
          <a
            href={`#${cat.id}`}
            class="text-gray-300 hover:text-white py-2 px-3 text-base font-medium hover:bg-white/5 rounded-lg transition-all sidebar-link"
          >
            {cat.titulo}
          </a>
        ))}
      </nav>
    </div>

    <div>
      <h3 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4">Contato</h3>
      <a 
        href="https://www.instagram.com/calveleburguer/"
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center gap-3 text-gray-300 hover:text-white py-2 transition-colors"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772 4.902 4.902 0 011.772-1.153c.636-.247 1.363-.416 2.427-.465C9.673 2.013 10.03 2 12.48 2h-.165zm0 5.838a5.838 5.838 0 100 11.676 5.838 5.838 0 000-11.676zm0 9.516a3.678 3.678 0 110-7.356 3.678 3.678 0 010 7.356zm5.838-7.356a1.44 1.44 0 110-2.88 1.44 1.44 0 010 2.88z" clip-rule="evenodd" /></svg>
        Instagram
      </a>
    </div>
  </div>

  <div class="p-6 border-t border-white/10 bg-black/30">
    <p class="text-xs text-gray-500 text-center">
      © Calvele Burguer
    </p>
  </div>
</aside>

<script>
  function setupMenu() {
    const menuToggle = document.getElementById('menu-toggle');
    const menuClose = document.getElementById('menu-close');
    const sidebar = document.getElementById('sidebar-menu');
    const overlay = document.getElementById('menu-overlay');
    const links = document.querySelectorAll('.sidebar-link');

    if (!menuToggle || !sidebar || !overlay) return;

    function openMenu() {
      sidebar?.classList.remove('-translate-x-full');
      sidebar?.setAttribute('aria-hidden', 'false');
      menuToggle?.setAttribute('aria-expanded', 'true');
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden'; // Impede scroll do fundo
    }

    function closeMenu() {
      sidebar?.classList.add('-translate-x-full');
      sidebar?.setAttribute('aria-hidden', 'true');
      menuToggle?.setAttribute('aria-expanded', 'false');
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = ''; // Libera scroll
    }

    // Eventos de Clique
    menuToggle.addEventListener('click', openMenu);
    if (menuClose) menuClose.addEventListener('click', closeMenu);
    overlay.addEventListener('click', closeMenu);

    // Fecha o menu ao clicar em qualquer link (UX)
    links.forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  }

  setupMenu();
  document.addEventListener('astro:after-swap', setupMenu);
</script>
