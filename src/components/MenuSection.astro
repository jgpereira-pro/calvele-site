---
// src/components/MenuSection.astro
import BurgerCard from "./BurgerCard.astro";

interface Props {
  id: string;
  titulo: string;
  itens: any[];
}

const { id, titulo, itens } = Astro.props;
---

<section
  id={id}
  class="bg-calvele-dark py-12 px-4 border-b border-white/5 last:border-0 scroll-mt-20"
>
  <div class="max-w-6xl mx-auto">
    <div class="mb-10">
      <h2
        class="text-2xl md:text-3xl font-bold text-white mb-2 uppercase tracking-tight italic"
      >
        {titulo}
      </h2>
      <div class="h-1 w-16 bg-calvele-yellow rounded-full"></div>
    </div>

    {
      itens.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {itens.map((item) => (
            <BurgerCard
              title={item.titulo}
              desc={item.descricao}
              price={item.preco}
              image={item.imagem}
              linkIfood={item.linkIfood}
              link99={item.link99}
            />
          ))}
        </div>
      ) : (
        <div class="bg-white/5 p-8 rounded-2xl border border-dashed border-white/10 text-center">
          <p class="text-gray-500 italic">Novidades chegando em breve nesta categoria...</p>
        </div>
      )
    }
  </div>
</section>
